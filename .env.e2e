# Loaded only when Vite runs with --mode e2e (playwright.config.ts's
# webServer command). Gates the deterministic-capture test hooks in
# main.tsx — see that file's doc comment. Never loaded by a normal
# `vite build`/`vite dev` (default "production"/"development" modes),
# so these hooks are never attached to `window` in a normal build.
VITE_E2E_TEST_HOOKS=true
