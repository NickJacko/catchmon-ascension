{
  "name": "catchmon-ascension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "node scripts/dev-mobile.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc --noEmit -p tsconfig.scale.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:legacy": "node scripts/validate-legacy-leaks.ts",
    "verify:e2e-hooks-absent": "node scripts/verify-e2e-hooks-absent.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:e2e": "playwright test",
    "test:e2e:bootstrap": "playwright test e2e/bootstrap.spec.ts",
    "test:e2e:scene": "playwright test e2e/living-shop-scene.spec.ts",
    "test:e2e:progression": "playwright test e2e/fresh-save-progression.spec.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm validate:legacy && pnpm test && pnpm build && pnpm verify:e2e-hooks-absent",
    "check:fast": "node scripts/check-fast.mjs",
    "check:affected": "node scripts/check-affected.mjs",
    "test:scale": "node scripts/scale-harness.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "dexie": "^4.4.5",
    "pixi.js": "^8.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "qrcode-terminal": "^0.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
