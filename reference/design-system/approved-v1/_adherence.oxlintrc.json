{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/shop/**",
              "ui_kits/shop_app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Baloo 2|Nunito Sans))/i]",
        "message": "Font not provided by the design system. Available: Baloo 2, Nunito Sans."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|fullWidth|disabled|iconLeft|iconRight|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, fullWidth, disabled, iconLeft, iconRight, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|destructive)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'destructive'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CatchmonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|art|element|caption|discovered|glow|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CatchmonCard> doesn't accept that prop. Declared props: name, art, element, caption, discovered, glow, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurrencyChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|amount|delta|size|style|key|ref|className|style|children)$/]",
        "message": "<CurrencyChip> doesn't accept that prop. Declared props: kind, amount, delta, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurrencyChip'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:coin|momentum|material)$/]",
        "message": "<CurrencyChip> kind must be one of 'coin' | 'momentum' | 'material'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CurrencyChip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<CurrencyChip> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ElementBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:element|size|showLabel|style|key|ref|className|style|children)$/]",
        "message": "<ElementBadge> doesn't accept that prop. Declared props: element, size, showLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ElementBadge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<ElementBadge> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|label|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|action|tone|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: title, subtitle, action, tone, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:cream|card|sand)$/]",
        "message": "<Panel> tone must be one of 'cream' | 'card' | 'sand'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|art|price|currencyGlyph|tier|element|status|count|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: name, art, price, currencyGlyph, tier, element, status, count, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:standard|fine|masterwork)$/]",
        "message": "<ProductCard> tier must be one of 'standard' | 'fine' | 'masterwork'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute > JSXIdentifier[name!=/^(?:art|label|size|locked|empty|tier|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Slot> doesn't accept that prop. Declared props: art, label, size, locked, empty, tier, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slot'] > JSXAttribute[name.name='tier'] > Literal[value!=/^(?:standard|fine|masterwork)$/]",
        "message": "<Slot> tier must be one of 'standard' | 'fine' | 'masterwork'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|style|key|ref|className|style|children)$/]",
        "message": "<StatusPill> doesn't accept that prop. Declared props: tone, icon, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusPill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:success|warning|error|info|premium|neutral)$/]",
        "message": "<StatusPill> tone must be one of 'success' | 'warning' | 'error' | 'info' | 'premium' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|icon|count|key|ref|className|style|children)$/]",
        "message": "<TabItem> doesn't accept that prop. Declared props: id, label, icon, count."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
